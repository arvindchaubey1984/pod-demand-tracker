# Single user — replace with your own values (do not commit real passwords)
VITE_AUTH_EMAIL=your.email@example.com
VITE_AUTH_PASSWORD=replace-with-a-strong-password
VITE_AUTH_NAME=Admin

# Or multiple users (JSON array). If set, this overrides the single-user vars above.
# VITE_AUTH_USERS=[{"email":"user1@example.com","password":"replace-me","name":"User 1"},{"email":"user2@example.com","password":"replace-me","name":"User 2"}]
